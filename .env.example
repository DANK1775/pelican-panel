PANEL_IMAGE=ghcr.io/dank1775/pelican-panel:latest
PANEL_PORT=8080

# Pelican core
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://urdomain.com
APP_INSTALLED=false
APP_LOCALE=es
APP_TIMEZONE=America/Costa_Rica

# Maria DB
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=pelican
DB_USERNAME=pelican
DB_PASSWORD=change this password
MYSQL_ROOT_PASSWORD=change this password

# Redis
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change this password

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user
MAIL_PASSWORD=password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@urdomain.com
MAIL_FROM_NAME="Pelican Panel"
